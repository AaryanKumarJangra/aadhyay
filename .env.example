# ---- Core ----
NODE_ENV=development
APP_BASE_DOMAIN=aadhyay.com            # tenant subdomains: <slug>.APP_BASE_DOMAIN
API_PORT=4000
REALTIME_PORT=4001
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000

# ---- Database (admin = migrations/control plane; app = RLS-enforced runtime role) ----
DATABASE_URL=postgresql://aadhyay_admin:aadhyay_admin@localhost:5432/aadhyay
APP_DATABASE_URL=postgresql://aadhyay_app:aadhyay_app@localhost:5432/aadhyay
REDIS_URL=redis://localhost:6379

# ---- Security ----
JWT_SECRET=change-me-64-chars-minimum-change-me-64-chars-minimum-change-me
ENCRYPTION_KEY=base64:REPLACE_WITH_32_BYTES_BASE64   # AES-256-GCM for tokens/secrets at rest
PHONE_HASH_PEPPER=change-me-pepper                   # HMAC pepper for contact discovery
OTP_DEV_ECHO=true                                    # dev only: return OTP in response

# ---- Storage (S3 compatible: R2 / E2E Object Storage / MinIO) ----
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=aadhyay
S3_ACCESS_KEY=aadhyay
S3_SECRET_KEY=aadhyay-secret

# ---- Messaging providers ----
EMAIL_PROVIDER=smtp                 # smtp | resend | ses
SMTP_URL=smtp://localhost:1025
RESEND_API_KEY=
SMS_PROVIDER=log                    # log | msg91 | fast2sms
SMS_API_KEY=
PUSH_PROVIDER=log                   # log | fcm
FCM_SERVICE_ACCOUNT_JSON=
WHATSAPP_PROVIDER=log               # log | meta
META_APP_SECRET=
META_VERIFY_TOKEN=
META_GRAPH_VERSION=v23.0
PLATFORM_WA_PHONE_NUMBER_ID=        # Aadhyay's own number (OTP, renewals)
PLATFORM_WA_TOKEN=

# ---- Payments ----
PAYMENT_PROVIDER=log                # log | razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Calls ----
TURN_URLS=turn:localhost:3478
TURN_SECRET=dev-turn-secret
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# ---- Company (GST) ----
COMPANY_GSTIN=
COMPANY_STATE_CODE=09               # 09 = Uttar Pradesh, 07 = Delhi
